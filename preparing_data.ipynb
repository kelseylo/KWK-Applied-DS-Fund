   "source": [
    "# removing non-ascii/english characters \n",
    "def englishify(text):\n",
    "    new_text = ''\n",
    "    for letter in text:\n",
    "        if letter.isascii() and (letter != '(' and letter != ')'):\n",
    "            new_text += letter\n",
    "    return new_text "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0c7dc0b3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# finding repeating songs and returns data list \n",
    "def findRepeatSongs(artist,fileName):\n",
    "    file = open(fileName,'r')\n",
    "    data = json.load(file)\n",
    "\n",
    "    repeated_songs_indicies = []\n",
    "    repeated_songs_titles = []\n",
    "    unique_song = englishify(data[0]['title'])\n",
    "    repeat = -1\n",
    "    for index, data_point in enumerate(data):\n",
    "        song = englishify(data_point['title'])\n",
    "\n",
    "        if fuzz.partial_token_sort_ratio(unique_song, song) < 60: \n",
    "            unique_song = song\n",
    "            repeat = -1\n",
    "            for repeated_index in repeated_songs_indicies:\n",
    "                data[repeated_index]['repeated_songs_indicies'] = repeated_songs_indicies\n",
    "                data[repeated_index]['repeated_songs_titles'] = repeated_songs_titles\n",
    "                data[repeated_index]['num_repeated_songs'] = len(repeated_songs_indicies)\n",
    "            repeated_songs_indicies = []\n",
    "            repeated_songs_titles = []\n",
    "        \n",
    "        repeat += 1\n",
    "        if repeat > -1:\n",
    "            repeated_songs_indicies.append(index)\n",
    "            repeated_songs_titles.append(data[index]['title'])\n",
    "\n",
    "    #for the last index\n",
    "    for repeated_index in repeated_songs_indicies:\n",
    "        data[repeated_index]['repeated_songs_indicies'] = repeated_songs_indicies\n",
    "        data[repeated_index]['repeated_songs_titles'] = repeated_songs_titles\n",
    "        data[repeated_index]['num_repeated_songs'] = len(repeated_songs_indicies)\n",
    "\n",
    "    dumpFile = open(f'{artist}_cleaned_songs.json', 'w')\n",
    "    json.dump(data, dumpFile, indent=4)\n",
    "    # return data \n",
    "\n"
   ]
