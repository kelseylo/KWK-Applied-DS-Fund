   "source": [
    "# Cleaning The Data Collected\n",
    "- *Find repeating songs*: \n",
    "- - iterates through all songs in raw_data/artist_songs_data files to identify repeating songs (different versions or translations)\n",
    "- *Finding empty songs*: \n",
    "- - iterates through all song lyrics in raw_data/lyrics files to identify any empty songs (instrumentals) --> saves updated songs_data to cleaned_data/artist_songs_data folder "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 173,
   "id": "c448213b",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from thefuzz import fuzz, process\n",
    "import pandas as pd\n",
    "from scipy import stats\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "51a78c31",
   "metadata": {},
   "source": [
    "# Finding missing date info"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7c17901f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def findMissingDate(artist, fileName):\n",
    "    file = open(fileName,'r')\n",
    "    data = json.load(file)\n",
    "\n",
    "    for index, datapoint in enumerate(data):\n",
    "        if (datapoint[\"release_date_components\"] == None\n",
    "        or datapoint['release_date_components']['year'] == None \n",
    "        or datapoint['release_date_components']['month'] == None \n",
    "        or datapoint['release_date_components']['day'] == None):\n",
    "            data[index]['missing_date_component'] = True\n",
    "        else: \n",
    "            data[index]['missing_date_component'] = False\n",
    "\n",
    "    dumpFile = open(f'{artist}_cleaned_songs.json', 'w')\n",
    "    json.dump(data, dumpFile, indent=4)\n",
    "\n",
    "# df = pd.DataFrame(data)\n",
    "# df.loc[346]"
   ]
  },
