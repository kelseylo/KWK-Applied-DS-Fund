    "# finding songs with no lyrics (eg instrumental)\n",
    "def findEmptySongs(artist, lyricsFile, dataFile):\n",
    "\n",
    "    all_lyrics = open(lyricsFile, 'r', errors='ignore')\n",
    "    curr_lyrics = []\n",
    "\n",
    "    file = open(dataFile,'r')\n",
    "    dataDict = json.load(file)\n",
    "\n",
    "\n",
    "    index = -1\n",
    "    for line in all_lyrics:\n",
    "        if 'SONG NAME [' in line:\n",
    "            song = line[len('SONG NAME ['):-1]\n",
    "            index += 1 #to find it in the dataDict list-dictionary\n",
    "            \n",
    "            if len(curr_lyrics) == 0:\n",
    "                dataDict[index-1]['empty'] = True\n",
    "            else:\n",
    "                dataDict[index-1]['empty'] = False\n",
    "            \n",
    "            curr_lyrics = []\n",
    "\n",
    "        elif not 'ContributorsTranslations' in line and not 'Read More' in line:\n",
    "            curr_lyrics.append(line)\n",
    "\n",
    "    # for the last index\n",
    "    if len(curr_lyrics) == 0:\n",
    "        dataDict[index]['empty'] = True\n",
    "    else:\n",
    "        dataDict[index]['empty'] = False\n",
    "\n",
    "    fileDump = open(f'{artist}_cleaned_songs.json','w')\n",
    "    json.dump(dataDict,fileDump,indent=4)\n",
    "    "
   ]
