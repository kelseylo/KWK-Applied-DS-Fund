    "# get artist popularity value from Spotify \n",
    "\n",
    "def getArtistPopularity(id):\n",
    "    \n",
    "    artist_req = requests.get(\n",
    "        f'{spotify_api}/artists/{id}',\n",
    "        # params={\n",
    "        #     'id' : artist_id,\n",
    "        # },\n",
    "        headers= spotify_headers\n",
    "    )\n",
    "\n",
    "    artist_json = artist_req.json()\n",
    "\n",
    "    return artist_json['popularity']\n",
    "\n"
   ]
