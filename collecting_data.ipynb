    "## Getting lyrics"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c15ede91",
   "metadata": {},
   "source": [
    "### Scrape all songs' lyrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1285c3d4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# getting full song lyrics of all songs in a list \n",
    "def getLyrics(songs):\n",
    "    all_songs_lyrics = []\n",
    "\n",
    "    for song in songs:\n",
    "        website = requests.get(song['url'])\n",
    "        soup = BeautifulSoup(website.text, 'lxml')\n",
    "        lyrics = soup.find_all('div', class_ = 'Lyrics__Container-sc-a49d8432-1 fBKwZw')\n",
    "\n",
    "        song_lyrics = []\n",
    "\n",
    "        for index, div in enumerate(lyrics): \n",
    "            for d in div:\n",
    "                if d.text != '':\n",
    "                    song_lyrics.append(d.text)\n",
    "\n",
    "        all_songs_lyrics.append(song_lyrics)\n",
    "    \n",
    "    return all_songs_lyrics\n"
   ]
  },
